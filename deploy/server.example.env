# Server-context template only.  Do not source this file and do not commit a
# filled copy.  The scripts parse key/value lines and reject these markers.
# The real file belongs outside the repository and is created after the
# read-only 1Panel/OpenResty/MySQL preflight.
SERVER_CONTEXT=<verified-server-context>
SITE_ROOT=/path/from-read-only-preflight/site-root
OPENRESTY_COMPOSE=/path/from-read-only-preflight/openresty-compose.yml
MYSQL_COMPOSE=/path/from-read-only-preflight/mysql-compose.yml
MYSQL_NETWORK_NAME=<network-name-from-read-only-preflight>
STABLE_APP_PORT=18080
STABLE_ADMIN_PORT=18081
CANDIDATE_APP_PORT=28080
CANDIDATE_ADMIN_PORT=28081
UPLOAD_DIR=/path/from-read-only-preflight/data/uploads
BACKUP_ROOT=/path/from-read-only-preflight/backups
SCHEMA_VERSION_FILE=/path/from-read-only-preflight/schema-version
DB_HOST=<mysql-host-from-read-only-preflight>
DB_PORT=3306
DB_NAME=<database-name-from-preflight>
DB_USER=<database-user-from-preflight>
DB_PASSWORD_FILE=/path/from-read-only-preflight/db-password
