APP_ENV=production
HTTP_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=https://<site-domain-from-read-only-preflight>
SITE_TIMEZONE=Asia/Shanghai

# Resolve DB_HOST from the actual MySQL service during the read-only 1Panel
# preflight.  This value is intentionally not a container name.
DB_HOST=<mysql-host-from-read-only-preflight>
DB_PORT=3306
DB_NAME=mywebsite
DB_USER=mywebsite
DB_PASSWORD_FILE=/run/secrets/db_password

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_EDGE=8000

SESSION_IDLE_DURATION=8h
SESSION_ABSOLUTE_DURATION=24h
COOKIE_SECURE=true

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT=5s
