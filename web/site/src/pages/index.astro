---
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../components/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { fetchHomePageData, HomeDataUnavailableError, type HomePageData } from "../lib/home-data";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

let home: HomePageData | null = null;
try {
  home = await fetchHomePageData();
} catch (error) {
  if (!(error instanceof HomeDataUnavailableError)) {
    console.error("home_data_unavailable", error);
  }
  home = null;
}

if (!home) Astro.response.status = 503;
---

{home ? (
  <BaseLayout title={`${home.site.name} — 个人网站`} description={home.site.description} year={home.year}>
    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero__content">
          <p class="eyebrow">{home.site.eyebrow}</p>
          <h1 id="hero-title">{home.site.name}</h1>
          <p class="lede">{home.site.description}</p>
          <div class="button-row">
            <a class="button button--primary" href="/articles">浏览文章</a>
            <a class="button button--secondary" href="/projects">浏览项目</a>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="latest-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="latest-heading">最新文章</h2>
            {home.articles.length > 0 && <a class="text-link" href="/articles">查看全部 <span aria-hidden="true">→</span></a>}
          </div>
          {home.articles.length > 0 ? (
            <div class="grid grid--three">
              {home.articles.map((article) => <ArticleCard article={article} />)}
            </div>
          ) : (
            <div class="empty-state">
              <h3>暂时没有公开文章</h3>
              <p>文章发布后会出现在这里。</p>
            </div>
          )}
        </div>
      </section>

      <section class="section section--projects" aria-labelledby="projects-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="projects-heading">项目</h2>
            {home.projects.length > 0 && <a class="text-link" href="/projects">查看全部 <span aria-hidden="true">→</span></a>}
          </div>
          {home.projects.length > 0 ? (
            <div class="grid grid--three project-grid">
              {home.projects.map((project) => <ProjectCard project={project} />)}
            </div>
          ) : (
            <div class="empty-state">
              <h3>暂时没有公开项目</h3>
              <p>公开项目后会出现在这里。</p>
            </div>
          )}
        </div>
      </section>

      <section class="section section--about" aria-labelledby="about-summary-heading">
        <div class="container about-summary">
          <img class="avatar" src={home.profile.avatar_url} alt={`${home.profile.name}的头像`} width="112" height="112" />
          <div class="about-summary__copy">
            <p class="eyebrow">ABOUT ME</p>
            <h2 id="about-summary-heading">{home.profile.name}</h2>
            <p>{home.profile.tagline}</p>
            <a class="text-link" href="/about">了解更多 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="首页暂时不可用 — Tazmi-Website" description="公开内容服务暂时不可用。">
    <main id="main-content" class="unavailable-page">
      <div class="container unavailable-card">
        <p class="eyebrow">Tazmi-Website</p>
        <h1>首页暂时不可用</h1>
        <p>公开内容服务暂时无法读取，请稍后重试。</p>
        <a class="text-link" href="/">重新加载首页 <span aria-hidden="true">↻</span></a>
      </div>
    </main>
  </BaseLayout>
)}
