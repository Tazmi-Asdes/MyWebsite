---
interface Props {
  active: "home" | "articles" | "projects" | "about";
}

const { active } = Astro.props;
---

<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-brand" href="/">Tazmi-Website</a>
    <details class="site-menu" open>
      <summary class="menu-button" aria-label="主要导航" aria-controls="site-navigation">
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav id="site-navigation" class="site-nav" aria-label="主要导航">
        <a href="/" aria-current={active === "home" ? "page" : undefined}>首页</a>
        <a href="/articles" aria-current={active === "articles" ? "page" : undefined}>文章</a>
        <a href="/projects" aria-current={active === "projects" ? "page" : undefined}>项目</a>
        <a href="/about" aria-current={active === "about" ? "page" : undefined}>关于</a>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          hidden
          aria-label="颜色主题模式"
        >
          <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5a8.5 8.5 0 1 0 11.7 11.7Z"></path>
          </svg>
          <svg class="theme-icon theme-icon--system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3.5" y="4" width="17" height="12" rx="1.5"></rect>
            <path d="M8 20h8M12 16v4"></path>
          </svg>
        </button>
      </nav>
    </details>
  </div>
</header>
