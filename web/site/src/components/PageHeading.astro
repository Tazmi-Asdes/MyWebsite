---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
}

const { eyebrow, heading, description } = Astro.props;
---

<header class="page-heading">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="lede">{description}</p>
  </div>
</header>
