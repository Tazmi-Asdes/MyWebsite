{
  "name": "mywebsite-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
